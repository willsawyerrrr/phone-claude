# Bearer token required on requests to /api/calls*
API_SECRET=

# Voice platform selection (only "vapi" is implemented)
VOICE_PROVIDER=vapi

# Vapi. VAPI_WEBHOOK_SECRET is the token configured on the assistant's
# webhook credential (Bearer auth, sent back in the x-vapi-secret header) —
# generate it, then set it in both places.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# Upstash Redis — used as the call store. Installing the Upstash Marketplace
# integration with the custom prefix "UPSTASH_REDIS_REST" creates exactly
# these two names (it prefixes Upstash's own KV_REST_API_URL/TOKEN names,
# rather than producing a plain UPSTASH_REDIS_REST_URL/TOKEN pair).
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
