# Bearer token required on requests to /api/calls*
API_SECRET=

# Voice platform selection (only "twilio" is implemented)
VOICE_PROVIDER=twilio

# This deployment's publicly reachable origin, used to build the TwiML and
# webhook URLs Twilio requests/POSTs back to (no trailing slash).
PUBLIC_BASE_URL=https://your-app.vercel.app

# Twilio. TWILIO_PHONE_NUMBER is the Twilio number calls are placed from
# (E.164 format); TWILIO_AUTH_TOKEN also verifies the X-Twilio-Signature on
# incoming requests to /api/twiml and /api/webhooks/twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Upstash Redis — used as the call store. Installing the Upstash Marketplace
# integration with the custom prefix "UPSTASH_REDIS_REST" creates exactly
# these two names (it prefixes Upstash's own KV_REST_API_URL/TOKEN names,
# rather than producing a plain UPSTASH_REDIS_REST_URL/TOKEN pair).
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
