# Bearer token required on requests to /api/calls*
API_SECRET=

# Voice platform selection (only "vapi" is implemented)
VOICE_PROVIDER=vapi

# Vapi
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# This deployment's own URL, used to set a per-call Vapi server URL override
# (optional — set the assistant's default server URL in the Vapi dashboard
# instead if per-call overrides aren't supported).
WEBHOOK_URL=

# Upstash Redis (via the Vercel Marketplace Redis integration, or a
# standalone Upstash database) — used as the call store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
