# The variables the stack reads. Copy this file to `.env` on the VM (see
# `docs/cloud-deploy.md`); only the two passwords and `PUBLIC_HOSTNAME` are
# required, and the `APNS_*` ones are needed only to ring a locked phone.
# Start the stack with `HOST_LAN_IP=<reserved IP> ./up.sh`; do not set
# `HOST_LAN_IP` here.
# Passwords must not contain `;` or newlines: Asterisk config would truncate them.
SOFTPHONE_PASSWORD=
ARI_PASSWORD=

# SIP account the soft-phone registers with.
SOFTPHONE_USERNAME=phone

# Asterisk REST Interface, used by `mcp-server` to originate and hang up calls.
ARI_USERNAME=phone-claude
ARI_PORT=8088
# Loopback only by default; set to the host's Tailscale IP if `mcp-server` runs
# on another machine. Never 0.0.0.0 on a public host.
ARI_BIND_ADDRESS=127.0.0.1

# SIP signalling port and the (bounded) RTP media range, published 1:1.
SIP_PORT=5060
RTP_START=10000
RTP_END=10100

# Space-separated networks Asterisk treats as local. Peers outside them are
# given HOST_LAN_IP in SIP. Docker presents LAN peers from a gateway address in
# a private Docker range, so list no private range: loopback only.
LOCAL_NET=127.0.0.0/8

# Voice pipeline HTTP API, used by `mcp-server`. Loopback only by default; set
# to the host's Tailscale IP if `mcp-server` runs on another machine. AudioSocket
# (9092) is reachable only inside the Docker network.
PIPELINE_PORT=8080
PIPELINE_BIND_ADDRESS=127.0.0.1

# mcp-server's Streamable HTTP endpoint, reached remotely by Claude Code.
# Port 80 so the URL needs no port; the container runs as root, so it can
# bind it. Loopback only by default; set to the host's Tailscale IP to reach
# it remotely. Never 0.0.0.0 on a public host.
MCP_PORT=80
MCP_BIND_ADDRESS=127.0.0.1

# How long the pipeline waits for the caller to start speaking, and how much
# silence after speech marks a reply as finished (seconds).
NO_INPUT_TIMEOUT_S=15
QUIET_PERIOD_S=1.5

# Longest reply captured (seconds), times a question is re-spoken on request,
# how long call state is kept (seconds), and the speech-detection threshold (0-1).
MAX_REPLY_S=60
MAX_REPEATS=3
CALL_TTL_S=3600
VAD_THRESHOLD=0.5

# Speech this many dB quieter than the loudest speech in a reply is treated as
# background (a TV, other people) and doesn't hold the reply open. 0 disables.
LOUDNESS_MARGIN_DB=12

# Debug: host directory to record each call's inbound audio (WAV) and speech
# detection (JSON) in, for tuning with `voice-pipeline/scripts/analyze_capture.py`.
# Leave unset to record nothing. The recordings are the caller's room audio,
# kept on this machine until you delete them.
# CAPTURE_DIR=./captures

# Text-to-speech voice: `alba-casual` or `alba-announcer`. See voice-pipeline/README.md.
TTS_VOICE=alba-casual

# Apple Push Notification service, to wake a locked phone with a VoIP push.
# Key id and team id of an APNs auth key. Its `.p8` file goes at
# `~/.config/phone-claude/apns_key.p8`.
APNS_KEY_ID=
APNS_TEAM_ID=
# The app's bundle id plus `.voip`.
APNS_TOPIC=dev.willsawyerrrr.phone-claude.voip
# Port where the phone registers its push token (authenticated with
# `SOFTPHONE_PASSWORD`), reached only through `caddy`'s HTTPS proxy.
DEVICE_PORT=8081
DEVICE_BIND_ADDRESS=127.0.0.1

# Public HTTPS: the phone reaches the stack over cellular, so `caddy` always
# runs (`COMPOSE_PROFILES=public`), terminating TLS on 443 with a Let's
# Encrypt certificate for `PUBLIC_HOSTNAME` and proxying only `PUT /device`.
# `PUBLIC_HOSTNAME` must resolve to this host, with port 443 open.
COMPOSE_PROFILES=public
PUBLIC_HOSTNAME=
# Asterisk also serves SIP over TLS on `TLS_PORT` with that certificate and
# requires SRTP; plain UDP/TCP SIP is off.
TLS_PORT=5061
