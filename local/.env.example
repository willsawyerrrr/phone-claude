# Copy to `.env` and fill in. Only the two passwords are required; the `APNS_*`
# ones are needed only to ring a locked phone. Start the stack with `./up.sh`,
# which sets `HOST_LAN_IP` (this machine's LAN IP) from the current network;
# `HOST_LAN_IP=<ip> ./up.sh` overrides it (on a cloud VM, its public IP; see
# `docs/cloud-deploy.md`). Do not set it here.
# Passwords must not contain `;` or newlines: Asterisk config would truncate them.
SOFTPHONE_PASSWORD=
ARI_PASSWORD=

# SIP account the soft-phone registers with.
SOFTPHONE_USERNAME=phone

# Asterisk REST Interface, used by `mcp-server` to originate and hang up calls.
ARI_USERNAME=phone-claude
ARI_PORT=8088
# Loopback only by default; set to the host's Tailscale IP if `mcp-server` runs
# on another machine. Never 0.0.0.0 on a public host.
ARI_BIND_ADDRESS=127.0.0.1

# SIP signalling port and the (bounded) RTP media range, published 1:1.
SIP_PORT=5060
RTP_START=10000
RTP_END=10100

# Space-separated networks Asterisk treats as local. Peers outside them are
# given HOST_LAN_IP in SIP. Docker presents LAN peers from a gateway address in
# a private Docker range, so list no private range: loopback only.
LOCAL_NET=127.0.0.0/8

# Voice pipeline HTTP API, used by `mcp-server`. Loopback only by default; set
# to the host's Tailscale IP if `mcp-server` runs on another machine. AudioSocket
# (9092) is reachable only inside the Docker network.
PIPELINE_PORT=8080
PIPELINE_BIND_ADDRESS=127.0.0.1

# How long the pipeline waits for the caller to start speaking, and how much
# silence after speech marks a reply as finished (seconds).
NO_INPUT_TIMEOUT_S=15
QUIET_PERIOD_S=1.5

# Longest reply captured (seconds), times a question is re-spoken on request,
# how long call state is kept (seconds), and the speech-detection threshold (0-1).
MAX_REPLY_S=60
MAX_REPEATS=3
CALL_TTL_S=3600
VAD_THRESHOLD=0.5

# Text-to-speech voice: `TTS_ENGINE` is `piper`, `kokoro` or `pocket`; `TTS_VOICE`
# names a voice of that engine and defaults per engine (`en_US-lessac-medium`,
# `af_heart`, `alba-casual`). See voice-pipeline/README.md.
TTS_ENGINE=piper
TTS_VOICE=

# Apple Push Notification service, to wake a locked phone with a VoIP push.
# Key id and team id of an APNs auth key, and the host path to its `.p8` file.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
# The app's bundle id plus `.voip`.
APNS_TOPIC=dev.willsawyerrrr.phone-claude.voip
# LAN port where the phone registers its push token (authenticated with
# `SOFTPHONE_PASSWORD`).
DEVICE_PORT=8081
# Address the device port is published on. Defaults to `HOST_LAN_IP`; set to
# `127.0.0.1` when `caddy` fronts it.
# DEVICE_BIND_ADDRESS=127.0.0.1

# Public HTTPS (a cloud host the phone reaches over cellular). Set
# `COMPOSE_PROFILES=public` to run `caddy`, which terminates TLS on 443 with a
# Let's Encrypt certificate for `PUBLIC_HOSTNAME` and proxies only `PUT /device`.
# `PUBLIC_HOSTNAME` must resolve to this host, with port 443 open.
# COMPOSE_PROFILES=public
# PUBLIC_HOSTNAME=phone.example.com
# With `PUBLIC_HOSTNAME` set, Asterisk also serves SIP over TLS on `TLS_PORT`
# with that certificate and requires SRTP; plain UDP/TCP SIP is off. Unset, it
# serves plain UDP/TCP and RTP (LAN).
TLS_PORT=5061
