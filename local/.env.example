# Copy to `.env` and fill in. Only the first three are required.

# This machine's LAN IP, as the phone reaches it (e.g. `ipconfig getifaddr en0`
# on macOS, `hostname -I` on Linux).
HOST_LAN_IP=192.168.1.10
SOFTPHONE_PASSWORD=
ARI_PASSWORD=

# SIP account the soft-phone registers with.
SOFTPHONE_USERNAME=phone

# Asterisk REST Interface, used by `mcp-server` to originate and hang up calls.
ARI_USERNAME=phone-claude
ARI_PORT=8088
# Loopback only by default; set to 0.0.0.0 if `mcp-server` runs on another machine.
ARI_BIND_ADDRESS=127.0.0.1

# SIP signalling port and the (bounded) RTP media range, published 1:1.
SIP_PORT=5060
RTP_START=10000
RTP_END=10100

# Space-separated networks Asterisk treats as local. Peers outside them are
# given HOST_LAN_IP in SIP/SDP. Must not include the phone's LAN subnet.
LOCAL_NET=127.0.0.0/8 172.16.0.0/12
