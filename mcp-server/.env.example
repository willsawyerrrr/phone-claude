# Nothing loads this file: it is a reference for the env passed via
# `claude mcp add --env` or the `.mcp.json` `env` block.

# Asterisk ARI credentials (`ARI_USERNAME`/`ARI_PASSWORD` in `local/.env`)
ARI_USERNAME=phone-claude
ARI_PASSWORD=

# Optional (defaults shown)
# `ARI_URL` and `PIPELINE_URL` must follow `ARI_PORT` and `PIPELINE_PORT` in `local/.env`.
ARI_URL=http://localhost:8088
PIPELINE_URL=http://localhost:8080
SIP_ENDPOINT=phone
DIALPLAN_CONTEXT=ask-by-phone
DIALPLAN_EXTENSION=700
POLL_INTERVAL_MS=3000
MAX_WAIT_MS=600000
