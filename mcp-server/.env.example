# Nothing loads this file: it is a reference for the variables `mcp-server`
# reads, supplied by the 1Password Environment through `op run` (see the root
# `README.md`).

# Asterisk ARI credentials (the same `ARI_USERNAME`/`ARI_PASSWORD` as the stack's)
ARI_USERNAME=phone-claude
ARI_PASSWORD=

# Optional (defaults shown)
# `ARI_URL` and `PIPELINE_URL` must follow `ARI_PORT` and `PIPELINE_PORT` in the stack's configuration.
ARI_URL=http://localhost:8088
PIPELINE_URL=http://localhost:8080
SIP_ENDPOINT=phone
DIALPLAN_CONTEXT=ask-by-phone
DIALPLAN_EXTENSION=700
POLL_INTERVAL_MS=3000
MAX_WAIT_MS=600000
PUSH_WAIT_MS=20000
RING_TIMEOUT_S=60
